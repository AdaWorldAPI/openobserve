# syntax=docker/dockerfile:1
# Railway image of this fork with ZITADEL login. Set the service's Dockerfile path to this file:
# Railpack cannot resolve the pinned nightly in rust-toolchain.toml, rustup here can.
FROM public.ecr.aws/docker/library/node:24-trixie AS webbuilder
WORKDIR /web
COPY ./web /web/
# package-lock.json is out of sync with package.json upstream, so `npm ci` refuses it.
RUN npm install --no-audit --no-fund
RUN NODE_OPTIONS="--max-old-space-size=8192" npm run build

FROM public.ecr.aws/docker/library/rust:1-trixie AS builder
RUN apt-get update && \
    apt-get install -y --no-install-recommends protobuf-compiler cmake clang libclang-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /openobserve
COPY . /openobserve
COPY --from=webbuilder /web/dist web/dist
RUN rustup show active-toolchain || rustup toolchain install
RUN cargo build --release --features zitadel

FROM public.ecr.aws/debian/debian:trixie-slim AS runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /openobserve/target/release/openobserve /
RUN ["/openobserve", "init-dir", "-p", "/data/"]
CMD ["/openobserve"]
